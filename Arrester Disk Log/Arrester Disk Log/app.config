<?xml version="1.0"?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="Arrester_Disk_Log.My.MySettings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false"/>
        </sectionGroup>
    </configSections>
    <connectionStrings/>
    <system.diagnostics>
        <sources>
            <!-- This section defines the logging configuration for My.Application.Log -->
            <source name="DefaultSource" switchName="DefaultSwitch">
                <listeners>
                    <add name="FileLog"/>
                    <!-- Uncomment the below section to write to the Application Event Log -->
                    <!--<add name="EventLog"/>-->
                </listeners>
            </source>
        </sources>
        <switches>
            <add name="DefaultSwitch" value="Information"/>
        </switches>
        <sharedListeners>
            <add name="FileLog" type="Microsoft.VisualBasic.Logging.FileLogTraceListener, Microsoft.VisualBasic, Version=8.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL" initializeData="FileLogWriter"/>
            <!-- Uncomment the below section and replace APPLICATION_NAME with the name of your application to write to the Application Event Log -->
            <!--<add name="EventLog" type="System.Diagnostics.EventLogTraceListener" initializeData="APPLICATION_NAME"/> -->
        </sharedListeners>
    </system.diagnostics>
    <userSettings>
        <Arrester_Disk_Log.My.MySettings>
            <setting name="GRoomConnectionString" serializeAs="String">
                <value>Data Source=USSTCSOLEANSQL1\MSSQLP601;Initial Catalog=GRoom;User ID=essay;Password=$35S@y!10L3@n</value>
            </setting>
            <setting name="ngd_productionConnectionString" serializeAs="String">
                <value>Data Source=USSTCSOLEANSQL1\MSSQLP601;Initial Catalog=ngd-production;User ID=essay;Password=$35S@y!10L3@n</value>
            </setting>
            <setting name="LastWorkOrder" serializeAs="String">
                <value>00000000</value>
            </setting>
            <setting name="EpoxySubGlass" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="AutoPrintReport" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="PolymerStationConnectionString" serializeAs="String">
                <value>Data Source=USSTCSOLEANSQL1\MSSQLP601;Initial Catalog=PolymerStation;User ID=essay;Password=$35S@y!10L3@n</value>
            </setting>
            <setting name="DBServer" serializeAs="String">
                <value>USSTCSOLEANSQL1\MSSQLP601</value>
            </setting>
            <setting name="Username" serializeAs="String">
                <value>essay</value>
            </setting>
            <setting name="Password" serializeAs="String">
                <value>$35S@y!10L3@n</value>
            </setting>
            <setting name="LoginTimeoutMs" serializeAs="String">
                <value>99999000</value>
            </setting>
        </Arrester_Disk_Log.My.MySettings>
    </userSettings>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup>
</configuration>
